# Core secrets (set strong random values in production)
SECRET_KEY=replace-with-strong-secret
REFRESH_SECRET_KEY=replace-with-strong-refresh-secret
CSRF_SECRET=replace-with-strong-csrf-secret

# Database
POSTGRES_DB=zerotrust
POSTGRES_USER=zt_user
POSTGRES_PASSWORD=zt_password
DATABASE_URL=sqlite:///./zerotrust.db

# Optional bootstrap admin (leave blank to disable auto-creation)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# App
DEBUG=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=30
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=120/minute
